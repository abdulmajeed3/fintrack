# ============================================================
# FinTrack Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit the .env file.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/fintrack_db"
# ── API Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ── JWT Secrets (generate with: openssl rand -base64 64) ────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
